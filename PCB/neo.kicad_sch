	(text "Load sharing:  USB present -> Q1 off, system runs from VBUS through D101 while the cell charges.\nUSB removed -> gate pulled low by the 100k, Q1 conducts and the cell feeds VSYS." (exclude_from_sim no) (at 25.4 190.5 0) (effects (font (size 1.27 1.27) (italic yes)) (justify left top)) (uuid "a19f2b8b-a266-4d77-b210-227496e2b630"))
	(text "SW101 disconnects the regulator only - the battery still charges with the keyboard switched off." (exclude_from_sim no) (at 25.4 198.12 0) (effects (font (size 1.27 1.27) (italic yes)) (justify left top)) (uuid "2db0e62d-351d-42e5-9c26-1f99fdd02fb5"))
	(text "XC6220: 8 uA quiescent current, 1 A LDO  (long standby for a BLE keyboard)." (exclude_from_sim no) (at 25.4 203.2 0) (effects (font (size 1.27 1.27) (italic yes)) (justify left top)) (uuid "89b3aeb4-b08e-43ba-b1c7-5ed5d913e6fd"))
	(text "Divider: VBAT x 0.713  (4.2 V -> 2.99 V), 1.5 uA drain.\nRead with SAADC on AIN0 (P0.02)." (exclude_from_sim no) (at 222.25 190.5 0) (effects (font (size 1.27 1.27) (italic yes)) (justify left top)) (uuid "4393ff61-e8e5-464a-b5ce-cf49352fb9c4"))
	(rectangle (start 299.72 25.4) (end 581.66 220.98) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "324d2f1d-7895-4438-ade8-0671dd44a799"))
	(text "MCU  -  nRF52840  (Bluetooth LE 5 / USB 2.0 FS)" (exclude_from_sim no) (at 302.26 31.4 0) (effects (font (size 2.8 2.8) (thickness 0.56) (bold yes)) (justify left bottom)) (uuid "4391f3ff-3c16-4c10-a4b2-6866e4e01059"))
